# Nokta - Environment Configuration
# Copy to .env and fill in your values

# Encryption key for provider API keys (AES-256-GCM, 32 bytes hex)
# Generate: openssl rand -hex 32
NOKTA_ENCRYPTION_KEY=

# JWT secret for auth tokens (any string, at least 32 chars recommended)
NOKTA_JWT_SECRET=

# Server-to-server API key for programmatic access (optional)
NOKTA_API_KEY=

# Server port and host
NOKTA_PORT=4217
NOKTA_HOST=127.0.0.1

# Environment: development, production, test
# In production, NOKTA_JWT_SECRET must be set explicitly
NODE_ENV=development

# Data directory (for .nokta/ databases and secrets)
NOKTA_DATA_DIR=.nokta

# Rate limiting (requests per minute per IP)
NOKTA_RATE_LIMIT=100

# Ollama server URL (for local AI models)
OLLAMA_HOST=http://localhost:11434

# Provider API keys (fallback if not configured via UI)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Path to project for file watching (default: current directory)
PROJECT_PATH=.

# Log level: debug, info, warn, error
NOKTA_LOG_LEVEL=info

# Stripe keys (for billing integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for subscription tiers
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# CORS: comma-separated allowed origins. Empty = same-origin only (secure). '*' = allow all (dev only).
NOKTA_CORS_ORIGIN=

# JWT token TTL in seconds (default: 604800 = 7 days)
NOKTA_TOKEN_TTL_SEC=604800

# Discovery cache TTL in milliseconds (default: 21600000 = 6 hours)
NOKTA_DISCOVERY_CACHE_TTL_MS=21600000

# Optional: the auto file watcher reacts to ANY file change, including manual
# edits, and the run it triggers can commit the working tree. Set to false to
# keep the daemon read-mostly while doing manual work. Default: enabled.
# NOKTA_AUTO_WATCHER=false

# Run isolation. Each run executes in its own git worktree
# (.nokta/worktrees/<run-id>, branch nokta/<run-id>) so it can never modify the
# tree that is running it. The run's changes stay on that branch for review;
# merge or discard them with git. Set false only to let runs edit in place.
# NOKTA_RUN_ISOLATION=false

# Refuse to run at all when isolation is unavailable (non-git project) instead
# of falling back to in-place edits. Recommended for unattended operation.
# NOKTA_REQUIRE_ISOLATION=true

# Where run worktrees are created. Relative paths resolve against the project
# root. Default: .nokta/worktrees
# NOKTA_WORKTREE_DIR=
