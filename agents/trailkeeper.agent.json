{
  "id": "agent.trailkeeper",
  "version": "0.1.0",
  "title": "Trailkeeper",
  "role": "Maintains durable session memory and verifies handoff completeness.",
  "scope": ["trail index", "session files", "handoff state", "compaction notes"],
  "inputs": ["current trail", "commands", "decisions", "validation status"],
  "outputs": ["updated trail", "handoff summary", "gate status"],
  "handoff": ["Active session path", "Last material step", "Validation status", "Next action"],
  "defaultPacks": ["core.trail-discipline"],
  "cannotDo": ["Declare completion with an incomplete trail"]
}
