{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nokta.local/schemas/trail-session.schema.json",
  "title": "TrailSession",
  "type": "object",
  "required": [
    "objective",
    "phase",
    "scope",
    "loadedContextPacks",
    "evidenceRead",
    "commandsRun",
    "decisionsMade",
    "whatWorked",
    "whatFailed",
    "risksAndBlockers",
    "validationStatus",
    "nextAction",
    "handoffSummary"
  ],
  "properties": {
    "objective": { "type": "string" },
    "phase": { "type": "string" },
    "scope": { "type": "string" },
    "loadedContextPacks": { "type": "array", "items": { "type": "string" } },
    "evidenceRead": { "type": "array", "items": { "type": "string" } },
    "commandsRun": { "type": "array", "items": { "type": "string" } },
    "decisionsMade": { "type": "array", "items": { "type": "string" } },
    "whatWorked": { "type": "array", "items": { "type": "string" } },
    "whatFailed": { "type": "array", "items": { "type": "string" } },
    "risksAndBlockers": { "type": "array", "items": { "type": "string" } },
    "validationStatus": { "type": "string" },
    "nextAction": { "type": "string" },
    "handoffSummary": { "type": "string" }
  },
  "additionalProperties": false
}
