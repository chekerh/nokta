{
  "name": "nokta-ai-operating-system",
  "version": "0.3.0",
  "private": true,
  "description": "A token-efficient AI operating system, context compiler, and trail protocol for software projects.",
  "type": "module",
  "bin": {
    "nokta": "./cli.mjs"
  },
  "scripts": {
    "daemon": "node daemon/index.mjs daemon",
    "compile": "node compiler/nokta-compile.mjs",
    "gates": "node compiler/nokta-gates.mjs",
    "init": "node compiler/nokta-init.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test tests/*.test.mjs",
    "lint": "eslint '**/*.mjs' --max-warnings 0",
    "format": "prettier --write '**/*.mjs' '**/*.json' '**/*.md'",
    "format:check": "prettier --check '**/*.mjs' '**/*.json' '**/*.md'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
